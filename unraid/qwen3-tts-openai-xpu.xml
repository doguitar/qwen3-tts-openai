<?xml version="1.0"?>
<Container version="2">
  <Name>qwen3-tts-openai-xpu</Name>
  <Repository>ghcr.io/doguitar/qwen3-tts-openai:xpu</Repository>
  <Registry>https://github.com/users/doguitar/packages/container/package/qwen3-tts-openai</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/doguitar/qwen3-tts-openai/issues</Support>
  <Project>https://github.com/doguitar/qwen3-tts-openai</Project>
  <Overview>OpenAI-compatible TTS for one multi-speaker Qwen3 fine-tune on Intel Arc XPU (Arc A380 / Alchemist). Mount your EasyFinetuning checkpoint at /models. Subwave Cloud URL is http://[IP]:8080/v1. Use the 0.6B checkpoint; A380 has 6GB.</Overview>
  <Category>AI: HomeAutomation:</Category>
  <WebUI>http://[IP]:[PORT:8080]/health</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/doguitar/qwen3-tts-openai/main/unraid/qwen3-tts-openai-xpu.xml</TemplateURL>
  <Icon>https://avatars.githubusercontent.com/u/1200188?v=4</Icon>
  <ExtraParams>--device=/dev/dri --group-add 18</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Unraid 7.0+ (or 6.12 with a kernel that supports Arc Alchemist). Host Intel GPU driver (i915/xe). Resizable BAR must be enabled (BAR 2 4GB+, not 256MB) or XPU kernels fail. Pass /dev/dri and group 18 (video). GHCR packages start private: docker login ghcr.io, or set the package public. Copy your SFT checkpoint into /mnt/user/appdata/qwen3-tts-openai/models before starting (see unraid/download-models.sh). A380: prefer the 0.6B fine-tune. Leave TTS_DTYPE=float32; float16 currently crashes during generate() on torch 2.13+xpu.</Requires>
  <Config Name="API Port" Target="8080" Default="8080" Mode="tcp" Description="OpenAI /v1/audio/speech listen port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Models" Target="/models" Default="/mnt/user/appdata/qwen3-tts-openai/models" Mode="ro" Description="Fine-tune checkpoint (model.safetensors + speech_tokenizer)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/qwen3-tts-openai/models</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/qwen3-tts-openai/config" Mode="rw" Description="Optional voices.json" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/qwen3-tts-openai/config</Config>
  <Config Name="Intel GPU" Target="" Default="" Mode="" Description="Render node for Arc XPU" Type="Device" Display="always" Required="true" Mask="false">/dev/dri</Config>
  <Config Name="TTS_MODEL" Target="TTS_MODEL" Default="/models" Mode="" Description="Checkpoint path inside the container" Type="Variable" Display="advanced" Required="false" Mask="false">/models</Config>
  <Config Name="TTS_DEVICE" Target="TTS_DEVICE" Default="xpu" Mode="" Description="Inference device (xpu, xpu:0, or cpu)" Type="Variable" Display="always" Required="false" Mask="false">xpu</Config>
  <Config Name="TTS_DTYPE" Target="TTS_DTYPE" Default="float32" Mode="" Description="A380: float32. float16 loads then crashes in torch._assert_async on current XPU wheels" Type="Variable" Display="always" Required="false" Mask="false">float32</Config>
  <Config Name="TTS_SPEAKERS" Target="TTS_SPEAKERS" Default="serling" Mode="" Description="Comma-separated speaker names in the fine-tune" Type="Variable" Display="always" Required="false" Mask="false">serling</Config>
  <Config Name="TTS_DEFAULT_VOICE" Target="TTS_DEFAULT_VOICE" Default="serling" Mode="" Description="Voice used when the request omits voice" Type="Variable" Display="always" Required="false" Mask="false">serling</Config>
  <Config Name="TTS_VOICES" Target="TTS_VOICES" Default="/config/voices.json" Mode="" Description="Optional name-to-speaker map" Type="Variable" Display="advanced" Required="false" Mask="false">/config/voices.json</Config>
  <Config Name="TTS_LANGUAGE" Target="TTS_LANGUAGE" Default="English" Mode="" Description="Default synthesis language" Type="Variable" Display="advanced" Required="false" Mask="false">English</Config>
  <Config Name="TTS_MODEL_NAME" Target="TTS_MODEL_NAME" Default="tts-1" Mode="" Description="OpenAI model id returned by GET /v1/models" Type="Variable" Display="advanced" Required="false" Mask="false">tts-1</Config>
</Container>
